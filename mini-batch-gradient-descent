c4962d0","metadata":{"execution":{"iopub.execute_input":"2026-10-20T15:09:55.8187Z","iopub.status.busy":"2026-10-20T15:09:55.817871Z","iopub.status.idle":"2026-10-20T15:09:55.827191Z","shell.execute_reply":"2026-10-20T15:09:55.826199Z"},"papermill":{"duration":0.014986,"end_time":"2026-10-20T15:09:55.829373+00:00","exception":false,"start_time":"2026-10-20T15:09:55.814387+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["\n","import numpy as np\n","\n","class MBGDRegressor:\n","    def __init__(self, batch_size, learning_rate=0.01, epochs=100):\n","        self.coef_ = None\n","        self.intercept_ = None\n","        self.lr = learning_rate\n","        self.epochs = epochs\n","        self.batch_size = batch_size\n","\n","    def fit(self, X_train, y_train):\n","        X_train = np.asarray(X_train)\n","        y_train = np.asarray(y_train).ravel()\n","\n","        n_samples, n_features = X_train.shape\n","\n","        # Initialize parameters\n","        self.intercept_ = 0.0\n","        self.coef_ = np.ones(n_features)\n","\n","        for epoch in range(self.epochs):\n","            # Shuffle the data indices for each epoch\n","            indices = np.random.permutation(n_samples)\n","\n","            for start in range(0, n_samples, self.batch_size):\n","                batch_idx = indices[start:start + self.batch_size]\n","\n","                X_batch = X_train[batch_idx]\n","                y_batch = y_train[batch_idx]\n","\n","                # Predictions\n","                y_hat = np.dot(X_batch, self.coef_) + self.intercept_\n","\n","                # Calculate gradients\n","                error = y_batch - y_hat\n","\n","                intercept_der = -2 * np.mean(error)\n","                coef_der = -2 * np.dot(X_batch.T, error) / len(batch_idx)\n","\n","                # Update parameters\n","                self.intercept_ -= self.lr * intercept_der\n","                self.coef_ -= self.lr * coef_der\n","\n","        return self\n","\n","    def predict(self, X_test):\n","        X_test = np.asarray(X_test)\n","        return np.dot(X_test, self.coef_) + self.intercept_\n"]},{"cell_type":"code","execution_count":10,"id":"e33836a6","metadata":{"execution":{"iopub.execute_input":"2026-10-20T15:09:55.835966Z","iopub.status.busy":"2026-10-20T15:09:55.83521Z","iopub.status.idle":"2026-10-20T15:09:55.83995Z","shell.execute_reply":"2026-10-20T15:09:55.8391Z"},"papermill":{"duration":0.010138,"end_time":"2026-10-20T15:09:55.841887+00:00","exception":false,"start_time":"2026-10-20T15:09:55.831749+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["mbr = MBGDRegressor(batch_size=int(X_train.shape[0]/10),epochs=500,learning_rate=0.010)"]},{"cell_type":"code","execution_count":11,"id":"a6920f65","metadata":{"execution":{"iopub.execute_input":"2026-10-20T15:09:55.848636Z","iopub.status.busy":"2026-10-20T15:09:55.848221Z","iopub.status.idle":"2026-10-20T15:09:55.983628Z","shell.execute_reply":"2026-10-20T15:09:55.98268Z"},"papermill":{"duration":0.141438,"end_time":"2026-10-20T15:09:55.985912+00:00","exception":false,"start_time":"2026-10-20T15:09:55.844474+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/plain":["<__main__.MBGDRegressor at 0x7987bb5ed010>"]},"execution_count":11,"metadata":{},"output_type":"execute_result"}],"source":["mbr.fit(X_train,y_train)"]},{"cell_type":"code","execution_count":12,"id":"7abe20c4","metadata":{"execution":{"iopub.execute_input":"2026-10-20T15:09:55.992806Z","iopub.status.busy":"2026-10-20T15:09:55.992327Z","iopub.status.idle":"2026-10-20T15:09:55.997289Z","shell.execute_reply":"2026-10-20T15:09:55.996309Z"},"papermill":{"duration":0.010912,"end_time":"2026-10-20T15:09:55.999341+00:00","exception":false,"start_time":"2026-10-20T15:09:55.988429+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["y_pred = mbr.predict(X_test)"]},{"cell_type":"code","execution_count":13,"id":"a6ace97b","metadata":{"execution":{"iopub.execute_input"