turn self\n","\n","    def predict(self, X_test):\n","        return np.dot(X_test, self.coef_) + self.intercept_\n"]},{"cell_type":"code","execution_count":10,"id":"43971e42","metadata":{"execution":{"iopub.execute_input":"2026-10-20T14:06:47.396131Z","iopub.status.busy":"2026-10-20T14:06:47.395781Z","iopub.status.idle":"2026-10-20T14:06:47.404065Z","shell.execute_reply":"2026-10-20T14:06:47.403182Z"},"papermill":{"duration":0.014549,"end_time":"2026-10-20T14:06:47.406277+00:00","exception":false,"start_time":"2026-10-20T14:06:47.391728+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/plain":["180"]},"execution_count":10,"metadata":{},"output_type":"execute_result"}],"source":["np.random.randint(0,X_train.shape[0])"]},{"cell_type":"code","execution_count":11,"id":"58e27fdb","metadata":{"execution":{"iopub.execute_input":"2026-10-20T14:06:47.413714Z","iopub.status.busy":"2026-10-20T14:06:47.413325Z","iopub.status.idle":"2026-10-20T14:06:47.420282Z","shell.execute_reply":"2026-10-20T14:06:47.419135Z"},"papermill":{"duration":0.013503,"end_time":"2026-10-20T14:06:47.422697+00:00","exception":false,"start_time":"2026-10-20T14:06:47.409194+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/plain":["(353, 10)"]},"execution_count":11,"metadata":{},"output_type":"execute_result"}],"source":["X_train.shape"]},{"cell_type":"code","execution_count":12,"id":"1b405b66","metadata":{"execution":{"iopub.execute_input":"2026-10-20T14:06:47.431028Z","iopub.status.busy":"2026-10-20T14:06:47.430679Z","iopub.status.idle":"2026-10-20T14:06:47.435599Z","shell.execute_reply":"2026-10-20T14:06:47.434657Z"},"papermill":{"duration":0.01164,"end_time":"2026-10-20T14:06:47.437568+00:00","exception":false,"start_time":"2026-10-20T14:06:47.425928+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["sgdr = SGDRegressor(epochs=100,learning_rate=0.20)"]},{"cell_type":"code","execution_count":13,"id":"8fad2a12","metadata":{"execution":{"iopub.execute_input"